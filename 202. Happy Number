class Solution:
    def isHappy(self, n: int) -> bool:
        l=[]
        l.append(n)
        while n!=1:
            s=0
            a=str(n)
            for i in range(len(a)):
                s+=int(a[i])**2
            if s not in l:
                l.append(s)
            else:
                return False
            n=s
        return True
    


        
